<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar" />


    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <!-- Splash background color -->
        <item name="windowSplashScreenBackground">@color/background</item>

        <!-- Circle color behind the icon -->
        <item name="windowSplashScreenIconBackgroundColor">@color/background</item>

        <!-- Icon to show in the center -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_ic</item>

        <!-- Theme that takes over after the splash -->
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>
</resources>